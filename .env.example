# Copy to .env (git-ignored). Both docker compose and the server read this.
POSTGRES_USER=gomoku
POSTGRES_PASSWORD=gomoku
POSTGRES_DB=gomoku
POSTGRES_PORT=5432
GOMOKU_PORT=3000

# Server (cargo run -p server) and tests (cargo test -p server)
GOMOKU_DATABASE_URL=postgres://gomoku:gomoku@localhost:5432/gomoku
GOMOKU_TEST_DATABASE_URL=postgres://gomoku:gomoku@localhost:5432/postgres
RUST_LOG=info,tower_http=info,sqlx=warn
